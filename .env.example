# Local-first defaults
DATA_DIR=.data
EXECUTION_MODE=demo
WORKSPACE_ROOT=~/.project-agent-control-plane/workspaces

# Set these when enabling live Git/Cline/GitHub execution.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_DEFAULT_BRANCH=main

CLINE_API_KEY=
CLINE_PROVIDER_ID=anthropic
CLINE_MODEL_ID=claude-sonnet-4-5

# Live-run capacity and durable lease recovery. Leases are renewed while a worker is healthy.
AGENT_MAX_CONCURRENT_RUNS=4
AGENT_MAX_CONCURRENT_RUNS_PER_PROJECT=2
AGENT_RUN_LEASE_MINUTES=5
AGENT_RUN_RECOVERY_BATCH_SIZE=25

# Local SQLite retention. Cleanup runs during successful startup and never removes active,
# failed, stopped, or human-review run evidence.
RUN_EVENT_RETENTION_DAYS=90
ACTIVITY_RETENTION_DAYS=180
COMPLETED_RUN_RETENTION_DAYS=365
REMOTE_DELIVERY_RETENTION_DAYS=180
